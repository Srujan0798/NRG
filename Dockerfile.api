# ==============================================================================
# Multi-stage Dockerfile for NRG API
# Stage 1: Builder - compile dependencies and assets
# Stage 2: Runner - non-root local stack runtime
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Builder
# ------------------------------------------------------------------------------
FROM python:3.11-slim AS builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gcc \
    g++ \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python build tools
RUN pip install --upgrade pip wheel setuptools

# Create virtualenv and install dependencies into it
RUN python -m venv /app/venv
ENV PATH=/app/venv/bin:$PATH

# Copy project files
COPY pyproject.toml .

# Install CPU-only torch FIRST — prevents sentence-transformers from pulling ~2GB CUDA packages
# which causes build timeout on Colima (aarch64 linux). CPU torch is sufficient for
# sentence-transformers inference in production.
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

# Install Python dependencies into venv
RUN pip install --no-cache-dir -e .

# Copy source code
COPY src/ ./src/
COPY scripts/ ./scripts/

# ------------------------------------------------------------------------------
# Stage 2: Runner
# ------------------------------------------------------------------------------
FROM builder AS runner

# Security: non-root user setup
RUN groupadd -r app && useradd -r -g app app
RUN mkdir -p /var/lib/nrg && chown app:app /var/lib/nrg

USER app

# Environment variables for production
ENV PATH=/app/venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONFAULTHANDLER=0 \
    UVICORN_WORKERS=4 \
    UVICORN_GRACEFUL_TIMEOUT=30 \
    UVICORN_TIMEOUT_KEEP_ALIVE=5

EXPOSE 8000

# Health check - uses the actual health endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 --start-interval=5s \
    CMD curl -f http://localhost:8000/health || exit 1

# Graceful shutdown with SIGTERM handling
CMD ["sh", "-c", "uvicorn src.api.main:app --host 0.0.0.0 --port 8000 --workers ${UVICORN_WORKERS:-4} --timeout-keep-alive ${UVICORN_TIMEOUT_KEEP_ALIVE:-5}"]
