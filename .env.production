# Sovereign LLM Mesh Configuration (IITGN Production)
# Multi-provider fallback with automatic failover

# Primary LLM Provider
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-IITGN_prod_openai_key_2025
OPENAI_MODEL=gpt-4-turbo

# Fallback Provider 1
ANTHROPIC_API_KEY=sk-ant-IITGN_prod_claude_key_2025
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Fallback Provider 2 (Azure)
AZURE_OPENAI_ENDPOINT=https://iitgn-sovereign-ai.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=nrg-gpt-4-turbo
AZURE_OPENAI_API_VERSION=2024-10-21

# LLM Mesh Settings
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_FALLBACK_ORDER=openai,anthropic,azure
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY_SECONDS=5

# Embedding Model (for vector search)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=ai4bharat/IndicBERTv2-SS

# Local Fallback (when API keys not configured)
LOCAL_MODEL_ENABLED=true
LOCAL_MODEL_NAME=llama-3.1-8b
