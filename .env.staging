# ==============================================================================
# Staging Environment Configuration
# Copy to .env.staging and customize with REAL secrets
# ==============================================================================

# Application environment
APP_ENV=staging
LOG_LEVEL=INFO
LOG_FORMAT=json

# ==============================================================================
# SECRETS - MUST BE SET BEFORE DEPLOYMENT
# ==============================================================================
POSTGRES_PASSWORD=CHANGE_ME_STAGING_PASSWORD
JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
REDIS_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32

# Database
POSTGRES_USER=nrg_staging
POSTGRES_DB=nrg_staging
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# Qdrant Vector DB
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=nrg_research_staging

# Redis
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
REDIS_PORT=6379
REDIS_HOST=redis

# JWT Configuration (staging - RS256 for production-like)
JWT_ALGORITHM=RS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=3

# CORS
CORS_ORIGINS=https://staging.nrg.gov.in

# LLM Provider
LLM_PROVIDER=gemini
GEMINI_API_KEY=CHANGE_ME_STAGING_GEMINI_KEY
GEMINI_MODEL=gemini-1.5-pro

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.staging.company.com:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_SERVICE_NAME=nrg-api-staging
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Feature flags
FEATURE_KG=true
FEATURE_CONSENT_UI=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10