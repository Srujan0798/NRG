{
  "name": "nrg-frontend",
  "version": "1.0.0",
  "description": "National Research Intelligence Platform Frontend",
  "main": "src/App.tsx",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build --emptyOutDir",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --rulesdir eslint-rules --report-unused-disable-directives --max-warnings 20",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:critical-path": "playwright test -c tests/playwright.config.ts tests/e2e",
    "test:a11y": "playwright test -c tests/playwright.config.ts tests/a11y/axe.test.ts",
    "test:contrast": "jest --runInBand tests/a11y/contrast.test.ts",
    "test:keyboard": "playwright test -c tests/playwright.config.ts tests/a11y/keyboard.test.ts",
    "forbidden-grep": "bash scripts/forbidden_phrases.sh",
    "lighthouse:mobile": "node scripts/run_lighthouse.mjs mobile",
    "lighthouse:desktop": "node scripts/run_lighthouse.mjs desktop",
    "storybook:build": "storybook build -o ../dist/storybook",
    "storybook:dev": "storybook dev -p 6006",
    "loki:test": "loki test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.99.0",
    "@types/d3": "^7.4.0",
    "@types/react-window": "^1.8.8",
    "autoprefixer": "^10.5.0",
    "axios": "^1.6.0",
    "clsx": "^2.0.0",
    "d3-drag": "^3.0.0",
    "d3-force": "^2.1.1",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.263.1",
    "postcss": "^8.5.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-window": "^2.2.7",
    "recharts": "^3.8.1",
    "tailwind-merge": "^2.0.0",
    "tailwindcss": "^3.4.19",
    "terser": "^5.46.1",
    "zustand": "^5.0.12"
  },
  "loki": {
    "configurations": {
      "chrome.desktop": {
        "target": "chrome.app",
        "width": 1366,
        "height": 768,
        "deviceScaleFactor": 1,
        "mobile": false
      }
    },
    "chromeSelector": "#storybook-root"
  },
  "overrides": {
    "tar": "7.5.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@playwright/test": "^1.59.1",
    "@storybook/addon-a11y": "^7.6.24",
    "@storybook/addon-essentials": "^7.6.24",
    "@storybook/react-vite": "^7.6.24",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitejs/plugin-react": "^4.0.0",
    "axe-core": "^4.11.3",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "http-server": "^14.1.1",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "loki": "^0.35.1",
    "storybook": "^7.6.24",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0",
    "vite": "^4.5.14",
    "wcag-color": "^1.1.1"
  }
}
