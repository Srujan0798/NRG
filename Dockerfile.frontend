# ==============================================================================
# Runtime Dockerfile for NRG Frontend
#
# The image builds the verified Vite output, then serves it with nginx. This
# keeps Docker Compose and CI smoke builds independent of a pre-existing local
# dist/frontend directory.
# ==============================================================================

FROM node:20-alpine AS frontend-builder

WORKDIR /app/frontend
ENV NPM_CONFIG_AUDIT=false \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_PROGRESS=false

COPY frontend/package*.json ./
RUN sh -eu -c '\
    npm ci --prefer-offline --no-audit --no-fund --progress=false & \
    pid="$!"; \
    while kill -0 "$pid" 2>/dev/null; do \
      echo "npm ci still running"; \
      sleep 30; \
    done; \
    wait "$pid" \
  '

COPY frontend/index.html frontend/tsconfig.json frontend/vite.config.ts ./
COPY frontend/postcss.config.js frontend/tailwind.config.js ./
COPY frontend/src/ ./src/
COPY frontend/public/ ./public/
RUN sh -eu -c '\
    npm run build & \
    pid="$!"; \
    while kill -0 "$pid" 2>/dev/null; do \
      echo "frontend build still running"; \
      sleep 30; \
    done; \
    wait "$pid" \
  '

FROM nginx:1.29-alpine

RUN apk upgrade --no-cache && \
    adduser -D -u 82 -g 82 -s /bin/sh nginx 2>/dev/null || true && \
    chown -R nginx:nginx /usr/share/nginx/html && \
    chown -R nginx:nginx /var/cache/nginx && \
    chown -R nginx:nginx /var/log/nginx && \
    chown -R nginx:nginx /etc/nginx/conf.d && \
    touch /var/run/nginx.pid && \
    chown -R nginx:nginx /var/run/nginx.pid

COPY --from=frontend-builder --chown=nginx:nginx /app/dist/frontend /usr/share/nginx/html
COPY infrastructure/nginx/frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD wget -q --spider http://localhost/ || exit 1

USER nginx

CMD ["nginx", "-g", "daemon off;"]
