# ==============================================================================
# Runtime Dockerfile for NRG Frontend
#
# Build the frontend first with:
#   npm --prefix frontend run build
#
# The Docker image packages the verified Vite output and serves it with nginx.
# Keeping dependency installation outside this image makes `docker compose up --build`
# predictable for local acceptance and handoff runs.
# ==============================================================================

FROM nginx:1.25-alpine

RUN adduser -D -u 82 -g 82 -s /bin/sh nginx 2>/dev/null || true && \
    chown -R nginx:nginx /usr/share/nginx/html && \
    chown -R nginx:nginx /var/cache/nginx && \
    chown -R nginx:nginx /var/log/nginx && \
    chown -R nginx:nginx /etc/nginx/conf.d && \
    touch /var/run/nginx.pid && \
    chown -R nginx:nginx /var/run/nginx.pid

COPY --chown=nginx:nginx dist/frontend /usr/share/nginx/html
COPY infrastructure/nginx/frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD wget -q --spider http://localhost/ || exit 1

USER nginx

CMD ["nginx", "-g", "daemon off;"]
