# ==============================================================================
# Staging Environment Configuration
# Copy to .env.staging and customize outside git.
# ==============================================================================

# Application environment
APP_ENV=staging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Secrets
POSTGRES_PASSWORD=CHANGE_ME_STAGING_PASSWORD
JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
REDIS_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32
NRG_PII_ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_base64_32

# Database
POSTGRES_USER=nrg_staging
POSTGRES_DB=nrg_staging
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# Qdrant Vector DB
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=nrg_research_staging

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379
REDIS_HOST=redis

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=7

# CORS
CORS_ORIGINS=https://staging.nrg.local

# LLM Provider
LLM_PROVIDER=gemini
GEMINI_API_KEY=CHANGE_ME_STAGING_GEMINI_KEY
GEMINI_MODEL=gemini-1.5-pro

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_SERVICE_NAME=nrg-api-staging
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Feature flags
FEATURE_KG=true
FEATURE_CONSENT_UI=true

# Rate limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=20
