{
  "openapi": "3.0.3",
  "info": {
    "title": "National Research Graph API",
    "description": "Sovereign AI platform for Indian research intelligence. Three-tier access: researcher, government, industry. All raw research data stays on Indian soil.",
    "version": "1.0.0",
    "contact": {
      "name": "NRG Platform Team"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Development server"
    },
    {
      "url": "https://api.nrg.india",
      "description": "Production server"
    }
  ],
  "paths": {
    "/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Authenticate user and issue token pair",
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": {"type": "string", "example": "researcher_user"},
                  "password": {"type": "string", "example": "researcher-pass"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentication successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access_token": {"type": "string"},
                    "refresh_token": {"type": "string"},
                    "token_type": {"type": "string", "example": "bearer"},
                    "expires_in": {"type": "integer", "example": 1800},
                    "user": {
                      "type": "object",
                      "properties": {
                        "id": {"type": "string"},
                        "username": {"type": "string"},
                        "role": {"type": "string", "enum": ["researcher", "government", "industry"]},
                        "tier": {"type": "integer"},
                        "researcher_id": {"type": "string"}
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {"description": "Invalid credentials"}
        }
      }
    },
    "/refresh": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Refresh access token",
        "operationId": "refreshTokens",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["refresh_token"],
                "properties": {
                  "refresh_token": {"type": "string"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {"description": "New token pair issued"},
          "401": {"description": "Invalid or expired refresh token"}
        }
      }
    },
    "/logout": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Revoke tokens and logout",
        "operationId": "logout",
        "security": [{"BearerAuth": []}],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "refresh_token": {"type": "string"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {"description": "Tokens revoked"}
        }
      }
    },
    "/query": {
      "post": {
        "tags": ["Query"],
        "summary": "Conversational research query through LangGraph orchestration",
        "operationId": "query",
        "security": [{"BearerAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["query"],
                "properties": {
                  "query": {"type": "string", "example": "Find ML researchers in Karnataka"},
                  "session_id": {"type": "string", "description": "Optional session ID for multi-turn"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Query response with citations",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "query_id": {"type": "string"},
                    "session_id": {"type": "string"},
                    "response": {"type": "string"},
                    "status": {"type": "string"},
                    "tier": {"type": "integer"},
                    "intent": {"type": "string"},
                    "routing_decision": {"type": "string"},
                    "verification_status": {"type": "boolean"},
                    "warnings": {"type": "array", "items": {"type": "object"}},
                    "retrieval_sources": {"type": "array", "items": {"type": "string"}},
                    "citations": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {"type": "string"},
                          "title": {"type": "string"},
                          "authors": {"type": "array", "items": {"type": "string"}},
                          "year": {"type": "integer"},
                          "relevance_score": {"type": "number"}
                        }
                      }
                    },
                    "conversation_history": {"type": "array"},
                    "provenance": {
                      "type": "object",
                      "properties": {
                        "planner": {"type": "string"},
                        "synth": {"type": "string"},
                        "verifier": {"type": "string"}
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {"description": "Security violation (PII/injection blocked)"},
          "500": {"description": "Internal error"}
        }
      }
    },
    "/query/graph": {
      "get": {
        "tags": ["Query"],
        "summary": "Get research network graph for visualization",
        "operationId": "getGraphData",
        "security": [{"BearerAuth": []}],
        "parameters": [
          {"name": "topic", "in": "query", "schema": {"type": "string"}, "description": "Topic to build graph around"}
        ],
        "responses": {
          "200": {
            "description": "Graph data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "nodes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {"type": "string"},
                          "label": {"type": "string"},
                          "type": {"type": "string", "enum": ["paper", "author", "institution", "topic"]}
                        }
                      }
                    },
                    "edges": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "source": {"type": "string"},
                          "target": {"type": "string"},
                          "type": {"type": "string"},
                          "weight": {"type": "number"}
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/researchers": {
      "get": {
        "tags": ["Data"],
        "summary": "List researchers (tier-shaped)",
        "operationId": "getResearchers",
        "security": [{"BearerAuth": []}],
        "parameters": [
          {"name": "state", "in": "query", "schema": {"type": "string"}},
          {"name": "research_area", "in": "query", "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "List of researchers shaped by access tier"}
        }
      }
    },
    "/publications": {
      "get": {
        "tags": ["Data"],
        "summary": "List publications (tier-shaped)",
        "operationId": "getPublications",
        "security": [{"BearerAuth": []}],
        "parameters": [
          {"name": "year", "in": "query", "schema": {"type": "integer"}},
          {"name": "limit", "in": "query", "schema": {"type": "integer", "default": 10}}
        ],
        "responses": {
          "200": {"description": "List of publications"}
        }
      }
    },
    "/stats": {
      "get": {
        "tags": ["Data"],
        "summary": "System statistics (tier-shaped)",
        "operationId": "getStats",
        "security": [{"BearerAuth": []}],
        "responses": {
          "200": {"description": "Dashboard statistics"}
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Basic liveness check",
        "operationId": "healthCheck",
        "responses": {"200": {"description": "Service is healthy"}}
      }
    },
    "/health/llm": {
      "get": {
        "tags": ["Health"],
        "summary": "LLM provider readiness",
        "operationId": "healthLLM",
        "responses": {
          "200": {
            "description": "LLM status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "planner": {
                      "type": "object",
                      "properties": {
                        "provider": {"type": "string"},
                        "model": {"type": "string"},
                        "ready": {"type": "boolean"}
                      }
                    },
                    "synth": {
                      "type": "object",
                      "properties": {
                        "provider": {"type": "string"},
                        "url": {"type": "string"},
                        "ready": {"type": "boolean"}
                      }
                    },
                    "verifier": {
                      "type": "object",
                      "properties": {
                        "provider": {"type": "string"},
                        "model": {"type": "string"},
                        "ready": {"type": "boolean"}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/consent": {
      "post": {
        "tags": ["DPDP Compliance"],
        "summary": "Grant consent for data processing (DPDP 2023)",
        "operationId": "grantConsent",
        "security": [{"BearerAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["scope"],
                "properties": {
                  "scope": {"type": "string", "enum": ["research", "analytics", "third_party_sharing"]}
                }
              }
            }
          }
        },
        "responses": {
          "200": {"description": "Consent granted"},
          "400": {"description": "Invalid scope"}
        }
      }
    },
    "/consent/{scope}": {
      "delete": {
        "tags": ["DPDP Compliance"],
        "summary": "Revoke consent (DPDP 2023)",
        "operationId": "revokeConsent",
        "security": [{"BearerAuth": []}],
        "parameters": [
          {"name": "scope", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "Consent revoked"},
          "404": {"description": "Consent not found"}
        }
      }
    },
    "/me/consents": {
      "get": {
        "tags": ["DPDP Compliance"],
        "summary": "List all consents for current user",
        "operationId": "listConsents",
        "security": [{"BearerAuth": []}],
        "responses": {
          "200": {"description": "User consents"}
        }
      }
    },
    "/me/data": {
      "get": {
        "tags": ["DPDP Compliance"],
        "summary": "Export all user data (DPDP right to access)",
        "operationId": "exportUserData",
        "security": [{"BearerAuth": []}],
        "responses": {
          "200": {"description": "User data export"}
        }
      },
      "delete": {
        "tags": ["DPDP Compliance"],
        "summary": "Erase all user data (DPDP right to erasure)",
        "operationId": "eraseUserData",
        "security": [{"BearerAuth": []}],
        "responses": {
          "200": {"description": "Data erased"}
        }
      }
    },
    "/audit/verify": {
      "get": {
        "tags": ["Admin"],
        "summary": "Verify audit chain integrity",
        "operationId": "verifyAuditChain",
        "security": [{"BearerAuth": []}],
        "responses": {
          "200": {
            "description": "Chain verification result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {"type": "boolean"},
                    "broken_indices": {"type": "array", "items": {"type": "integer"}},
                    "last_sealed_at": {"type": "string"},
                    "current_head_hash": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/.well-known/jwks.json": {
      "get": {
        "tags": ["Authentication"],
        "summary": "JSON Web Key Set for JWT verification",
        "operationId": "getJWKS",
        "responses": {
          "200": {
            "description": "JWKS",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "keys": {"type": "array", "items": {"type": "object"}}
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}