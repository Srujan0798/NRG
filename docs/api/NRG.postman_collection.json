{
  "info": {
    "name": "National Research Graph API",
    "description": "Sovereign AI platform for Indian research intelligence",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('access_token', jsonData.access_token);",
                  "pm.collectionVariables.set('refresh_token', jsonData.refresh_token);",
                  "pm.test('Has access_token', function() {",
                  "    pm.expect(jsonData).to.have.property('access_token');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"researcher_user\",\n    \"password\": \"researcher-pass\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": ["{{baseUrl}}"],
              "path": ["login"]
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"refresh_token\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["refresh"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"refresh_token\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/logout",
              "host": ["{{baseUrl}}"],
              "path": ["logout"]
            }
          }
        },
        {
          "name": "Get JWKS",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/.well-known/jwks.json",
              "host": ["{{baseUrl}}"],
              "path": [".well-known", "jwks.json"]
            }
          }
        }
      ]
    },
    {
      "name": "Query",
      "item": [
        {
          "name": "Query Research",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"query\": \"Find ML researchers in Karnataka\",\n    \"session_id\": \"demo-session-1\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/query",
              "host": ["{{baseUrl}}"],
              "path": ["query"]
            }
          }
        },
        {
          "name": "Get Graph Data",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/query/graph?topic=machine%20learning",
              "host": ["{{baseUrl}}"],
              "path": ["query", "graph"],
              "query": [
                {
                  "key": "topic",
                  "value": "machine learning"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Data",
      "item": [
        {
          "name": "Get Researchers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/researchers",
              "host": ["{{baseUrl}}"],
              "path": ["researchers"]
            }
          }
        },
        {
          "name": "Get Publications",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/publications?limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["publications"],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Get Stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/stats",
              "host": ["{{baseUrl}}"],
              "path": ["stats"]
            }
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Basic Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "LLM Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/llm",
              "host": ["{{baseUrl}}"],
              "path": ["health", "llm"]
            }
          }
        }
      ]
    },
    {
      "name": "DPDP Compliance",
      "item": [
        {
          "name": "Grant Consent",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"scope\": \"research\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/consent",
              "host": ["{{baseUrl}}"],
              "path": ["consent"]
            }
          }
        },
        {
          "name": "List Consents",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/me/consents",
              "host": ["{{baseUrl}}"],
              "path": ["me", "consents"]
            }
          }
        },
        {
          "name": "Revoke Consent",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/consent/research",
              "host": ["{{baseUrl}}"],
              "path": ["consent", "research"]
            }
          }
        },
        {
          "name": "Export User Data",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/me/data",
              "host": ["{{baseUrl}}"],
              "path": ["me", "data"]
            }
          }
        },
        {
          "name": "Erase User Data",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/me/data",
              "host": ["{{baseUrl}}"],
              "path": ["me", "data"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Verify Audit Chain",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/audit/verify",
              "host": ["{{baseUrl}}"],
              "path": ["audit", "verify"]
            }
          }
        }
      ]
    }
  ]
}