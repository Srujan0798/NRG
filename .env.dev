# ==============================================================================
# Development Environment Configuration
# Copy to .env.dev and customize
# ==============================================================================

# Application environment
APP_ENV=dev
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# Database
POSTGRES_USER=nrg_dev
POSTGRES_PASSWORD=dev_secret_password_change_in_prod
POSTGRES_DB=nrg_dev
DATABASE_URL=postgresql://nrg_dev:dev_secret_password_change_in_prod@postgres:5432/nrg_dev
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# Qdrant Vector DB
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=nrg_research_dev

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379
REDIS_HOST=redis

# JWT Configuration (development keys - DO NOT USE IN PRODUCTION)
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# API Ports
API_PORT=8000
FRONTEND_PORT=3000
NGINX_PORT=80
NGINX_SSL_PORT=443
KONG_PORT=8080
KONG_SSL_PORT=8443

# LLM Provider (development settings)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-1.5-flash

# Feature flags
FEATURE_KG=true
FEATURE_CONSENT_UI=true

# Observability (dev - console output)
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Demo credentials (development only - NEVER commit real credentials)
DEMO_RESEARCHER_USERNAME=researcher_user
DEMO_RESEARCHER_PASSWORD=researcher-pass
DEMO_GOVERNMENT_USERNAME=gov_user
DEMO_GOVERNMENT_PASSWORD=government-pass
DEMO_INDUSTRY_USERNAME=industry_user
DEMO_INDUSTRY_PASSWORD=industry-pass