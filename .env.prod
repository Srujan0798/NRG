# ==============================================================================
# Production Environment Configuration
# Copy to .env.prod and customize with REAL secrets
# ==============================================================================

# Application environment
APP_ENV=prod
LOG_LEVEL=WARNING
LOG_FORMAT=json

# ==============================================================================
# SECRETS - MUST BE SET BEFORE DEPLOYMENT
# Generate secure values: openssl rand -hex 32
# ==============================================================================
POSTGRES_PASSWORD=CHANGE_ME_PRODUCTION_PASSWORD
JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
REDIS_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32

# Database
POSTGRES_USER=nrg_prod
POSTGRES_DB=nrg_prod
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# Qdrant Vector DB
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=nrg_research_prod

# Redis
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
REDIS_PORT=6379
REDIS_HOST=redis

# JWT Configuration (production - RS256 required)
JWT_ALGORITHM=RS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=1
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem

# CORS (update with actual domains)
CORS_ORIGINS=https://nrg.gov.in,https://api.nrg.gov.in

# API Ports
API_PORT=8000
FRONTEND_PORT=3000
NGINX_PORT=80
NGINX_SSL_PORT=443
KONG_PORT=8080
KONG_SSL_PORT=8443

# ==============================================================================
# LLM Provider - PRODUCTION KEYS REQUIRED
# ==============================================================================
LLM_PROVIDER=gemini
GEMINI_API_KEY=CHANGE_ME_PRODUCTION_GEMINI_KEY
GEMINI_MODEL=gemini-1.5-pro

# ==============================================================================
# Observability (configure for your infrastructure)
# ==============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.company.com:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_SERVICE_NAME=nrg-api
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# ==============================================================================
# Feature flags (production)
# ==============================================================================
FEATURE_KG=true
FEATURE_CONSENT_UI=true

# ==============================================================================
# Rate Limiting (production - stricter)
# ==============================================================================
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=20

# ==============================================================================
# Graceful Shutdown
# ==============================================================================
UVICORN_GRACEFUL_TIMEOUT=30
UVICORN_WORKERS=4
UVICORN_TIMEOUT_KEEP_ALIVE=5