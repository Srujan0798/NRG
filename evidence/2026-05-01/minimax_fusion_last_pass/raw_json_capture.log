{
  "role": "government",
  "tier": 2,
  "query": "Show TRL stage distribution for technology programs",
  "status_code": 200,
  "audit_event_id": "32a0ada808370d9b3cd16f392b36b25c6af37fa1918fe1f9b7e36facf558230c",
  "confidence": {
    "level": "high",
    "reason": "Evidence and citations passed verification."
  },
  "citations_count": 1,
  "sql_query": "SELECT stage_of_technology, COUNT(*) AS innovation_count FROM trl_stages GROUP BY stage_of_technology ORDER BY CASE stage_of_technology WHEN 'Level 1' THEN 1 WHEN 'Level 2' THEN 2 WHEN 'Level 3' THEN 3 WHEN 'Level 4' THEN 4 WHEN 'Level 5' THEN 5 WHEN 'Level 6' THEN 6 WHEN 'Level 7' THEN 7 WHEN 'Level 8' THEN 8 WHEN 'Level 9' THEN 9 ELSE 99 END",
  "source_rows_preview": [
    {
      "stage_of_technology": "Level 1",
      "innovation_count": 444
    },
    {
      "stage_of_technology": "Level 2",
      "innovation_count": 444
    }
  ],
  "response_preview": "TRL stage distribution is available from the normalized `trl_stages` view. The visible corpus contains 10,000 TRL rows across 9 stages. Level 4 is the largest stage with 4,440 rows. Market Ready / TRL-9 is normalized to `Level 9` and accounts for 2,440 rows (24.4% of the visible distribution). This directly addresses the Dhairya audit string-mismatch risk by never querying the stored value as `TRL 9`. [cite:trl_stage"
}
