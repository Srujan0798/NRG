# Host-local development template.
# Copy values into your private shell or ignored .env file when running tools on macOS.

APP_ENV=dev
LOG_LEVEL=DEBUG

# Host-visible service ports published by docker-compose.yml.
DATABASE_URL=postgresql://nrg:nrg_default_password@localhost:5432/nrg
POSTGRES_USER=nrg
POSTGRES_PASSWORD=nrg_default_password
POSTGRES_DB=nrg
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
PGBOUNCER_PORT=6432

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=nrg_research

REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

API_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000
FRONTEND_PORT=3000
API_PORT=8000

# Local seeded account passwords only. Override with strong unique values outside local development.
RESEARCHER_PASSWORD=researcher-pass
GOV_PASSWORD=government-pass
INDUSTRY_PASSWORD=industry-pass

JWT_SECRET=development-secret-key-2026
JWT_ALGORITHM=HS256
AUDIT_CHAIN_KEY=nrg-audit-chain-dev-key

CORS_ORIGINS=http://localhost:3000,http://localhost:4173,http://127.0.0.1:3000,http://127.0.0.1:4173
