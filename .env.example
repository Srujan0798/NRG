# National Research Graph - Environment Configuration
# Copy this file to .env and fill in your values

# ===================
# Database (SQLite for development, PostgreSQL for production)
# ===================
DATABASE_URL=sqlite:///nrg_research.db
# For PostgreSQL: DATABASE_URL=postgresql://nrg:nrg_secret@localhost:5432/nrg

QDRANT_HOST=localhost
QDRANT_PORT=6333
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ===================
# Security
# ===================
SECRET_KEY=your-secret-key-here-change-in-production

# JWT Configuration (RS256 for production with key files)
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=infrastructure/kong/ssl/jwt_rsa.key
JWT_PUBLIC_KEY_PATH=infrastructure/kong/ssl/jwt_rsa.pub
JWT_EXPIRATION_MINUTES=60

# Fallback to HS256 if keys not available (dev only)
JWT_SECRET=development-secret-key-2026

# Audit Chain HMAC Key (generate with: openssl rand -hex 32)
AUDIT_CHAIN_KEY=your-audit-chain-key-here-change-in-production

# ===================
# API Configuration
# ===================
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ===================
# Rate Limiting by Tier
# ===================
TIER1_RATE_LIMIT=100
TIER2_RATE_LIMIT=50
TIER3_RATE_LIMIT=20

# ===================
# Logging
# ===================
LOG_LEVEL=INFO
LOG_FORMAT=json
AUDIT_LOG_ENABLED=true

# ===================
# LLM Configuration (REQUIRED for AI synthesis)
# Get a free Gemini key: https://makersuite.google.com/app/apikey
# Or use OpenAI/Anthropic
# ===================
LLM_PROVIDER=gemini
LLM_REQUEST_TIMEOUT_SECONDS=30

# Google Gemini (free tier available)
GEMINI_API_KEY=AIzaSy_REPLACE_ME_WITH_REAL_KEY
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (optional fallback)
# OPENAI_API_KEY=sk-REPLACE_ME_WITH_REAL_KEY
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1/responses

# Anthropic (optional fallback)
# ANTHROPIC_API_KEY=sk-ant-REPLACE_ME_WITH_REAL_KEY
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages

# Azure OpenAI (optional fallback)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_MODEL=
# AZURE_OPENAI_API_VERSION=2024-10-21

# LLM Fallback Order (comma-separated, tries in order)
# LLM_FALLBACK_ORDER=gemini,openai,anthropic

# ===================
# Demo User Credentials
# Change these in production!
# ===================
RESEARCHER_PASSWORD=researcher-pass
GOV_PASSWORD=government-pass
INDUSTRY_PASSWORD=industry-pass

# ===================
# Frontend
# ===================
VITE_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
