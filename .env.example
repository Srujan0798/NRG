# Path to the National Research Database source corpus (CSVs + documents)
# On a fresh clone, place the corpus at data/National_Research_Database/ or set this var.
NRG_DATA_SOURCE_DIR=data/National_Research_Database
DATABASE_URL=sqlite:///nrg_research.db
POSTGRES_DATABASE_URL=postgresql://nrg:nrg_secret@localhost:5432/nrg
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=nrg_research
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL_INDIC=ai4bharat/IndicBERTv2-SS
JWT_ALGORITHM=RS256
# Required only if JWT_ALGORITHM is HS256/HS384/HS512. Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-openssl-rand-base64-32-output-minimum
JWT_PRIVATE_KEY_PATH=infrastructure/kong/ssl/jwt_rsa.key
JWT_PUBLIC_KEY_PATH=infrastructure/kong/ssl/jwt_rsa.pub
JWT_ISSUER=nrg-iitgn
JWT_AUDIENCE=nrg-clients
JWT_EXPIRY_SECONDS=3600
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14
AUDIT_CHAIN_KEY=nrg-audit-chain-dev-key
# Dev key only. In staging/prod, set one stable 32-byte secret across all API instances.
# Changing AUDIT_CHAIN_KEY after events exist breaks audit-chain verification unless rebuilt or sealed.
NRG_PII_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32-output
# Required for PII field encryption. Generate with: openssl rand -base64 32
AUDIT_AUTO_REPAIR_LINE1=false
CORS_ORIGINS=http://localhost:3000
API_HOST=0.0.0.0
API_PORT=8000
TRUST_PROXY_HEADERS=true
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=false
LLM_PROVIDER=gemini
LLM_PLANNER_PROVIDER=gemini
LLM_SYNTH_PROVIDER=local_llama
LLM_VERIFIER_PROVIDER=anthropic
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_TIMEOUT_BUDGET=15
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
LLAMA_CPP_URL=http://localhost:8080
LOCAL_LLM_CONTEXT_TOKENS=8192
RESEARCHER_PASSWORD=researcher-pass
GOV_PASSWORD=government-pass
INDUSTRY_PASSWORD=industry-pass
FEATURE_KG=0
FEATURE_CONSENT_UI=0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_ENDPOINT=
PAGERDUTY_ROUTING_KEY=
CLOUD_SYNTHESIS_ALLOWED=false
