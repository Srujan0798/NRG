# ==============================================================================
# Development Environment Configuration
# Copy to .env.dev and customize
# ==============================================================================

# Application environment
APP_ENV=dev
LOG_LEVEL=DEBUG

# Database
POSTGRES_USER=nrg_dev
POSTGRES_PASSWORD=dev_secret_password_change_in_prod
POSTGRES_DB=nrg_dev
DATABASE_URL=postgresql://nrg_dev:dev_secret_password_change_in_prod@postgres:5432/nrg_dev
POSTGRES_PORT=5432

# Qdrant Vector DB
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=nrg_research_dev

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# JWT Configuration (development keys - DO NOT USE IN PRODUCTION)
JWT_ALGORITHM=HS256
JWT_SECRET=development-secret-key-2026-minimum-32-bytes
JWT_ISSUER=nrg-iitgn
JWT_AUDIENCE=nrg-clients
JWT_EXPIRY_SECONDS=3600
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=7
# Generate real keys for production: openssl genrsa -out private.pem 2048

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# API Ports
API_PORT=8000
FRONTEND_PORT=5173
NGINX_PORT=80
NGINX_SSL_PORT=443
KONG_PORT=8080
KONG_SSL_PORT=8443

# LLM Provider (development settings)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-1.5-flash

# Feature flags
FEATURE_KG=true
FEATURE_CONSENT_UI=true

# Observability (dev - console output)
# For production, configure OTEL_EXPORTER_OTLP_ENDPOINT
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Development credentials (development only - NEVER commit real credentials)
RESEARCHER_USERNAME=researcher_user
RESEARCHER_PASSWORD=researcher-pass
GOV_USERNAME=gov_user
GOV_PASSWORD=government-pass
INDUSTRY_USERNAME=industry_user
INDUSTRY_PASSWORD=industry-pass
